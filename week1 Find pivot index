lass Solution {
    public int pivotIndex(int[] nums) {
        int total = 0;

        // Find total sum
        for (int num : nums) {
            total += num;
        }

        int leftSum = 0;

        // Find pivot index
        for (int i = 0; i < nums.length; i++) {
            if (leftSum == total - leftSum - nums[i]) {
                return i;
            }
            leftSum += nums[i];
        }

        return -1;
    }
}


